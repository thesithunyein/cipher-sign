# Product path: wallet → InstructionSender on Coston2 → poll TEE /action/result
# /fcc is still required for /info and instruction result polling (Vite/Vercel proxy).

VITE_DIRECT_URL=/fcc
VITE_DIRECT_API_KEY=same-as-tee-DIRECT_API_KEY

# On-chain InstructionSender (Coston2)
VITE_INSTRUCTION_SENDER=0x79bB3e509B6a0f43d506a761Fb022221c3FF0Ee9
VITE_CHAIN_ID=114
VITE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_EXPLORER_URL=https://coston2-explorer.flare.network
VITE_FEE_WEI=1000000000000
