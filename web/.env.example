# Local live TEE for screen record (Vite proxies /fcc → :6674, no CORS issues).
# After tee stack is up: npm run live:smoke && npm run dev
#
# Vercel hosted Live mode (optional): set these to your public HTTPS tunnel to :6674
#   VITE_DIRECT_URL=https://your-tunnel.example
#   VITE_DIRECT_API_KEY=<same as tee DIRECT_API_KEY>
# Do NOT set VITE_DIRECT_URL=/fcc on Vercel (that only works with local Vite proxy).

VITE_DIRECT_URL=/fcc
VITE_DIRECT_API_KEY=same-as-tee-DIRECT_API_KEY
